# Copy this file to .env.local and fill in real values.

# Supabase project settings -> API. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — never prefix with NEXT_PUBLIC_ and never commit.
# Used by the background generation task, which runs after the response is
# sent and so no longer has the user's cookie session.
SUPABASE_SECRET_KEY=

# Optional. Without it the router falls back to Pollinations (no key needed).
GEMINI_API_KEY=
